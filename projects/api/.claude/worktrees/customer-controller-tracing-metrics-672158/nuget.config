<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!--
      Private Azure Artifacts feed. Uncomment and set the URL.
      Locally the Azure Artifacts credential provider prompts for sign-in (run restore in interactive mode).
      In Docker, pass the same URL as NUGET_FEED_URL and a PAT with Packaging (Read) as NUGET_PAT.
    -->
    <!-- <add key="mrjb" value="https://pkgs.dev.azure.com/<org>/_packaging/<feed>/nuget/v3/index.json" /> -->
  </packageSources>

  <!--
    Optional: route packages to a specific feed so private package names can't be served from nuget.org.
    Uncomment together with the private feed above.
  -->
  <!--
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="mrjb">
      <package pattern="MrJB.*" />
    </packageSource>
  </packageSourceMapping>
  -->
</configuration>
